# --- required ----------------------------------------------------------------
# One key covers all three remote paths: answering, embeddings, and speech to
# text. GOOGLE_API_KEY is accepted as the older name.
GEMINI_API_KEY=your_gemini_api_key_here

# --- models (defaults shown; all optional) -----------------------------------
# Chosen by measurement rather than by tier — see the table in kb/gemini.py.
# Text and audio differ because the price lists differ by modality: 3.1-flash-lite
# is cheaper per text token, 3.5-flash-lite is cheaper per audio token.
# Do NOT use a "-latest" alias: answer text is the TTS cache key, so a silent
# model swap invalidates every prewarmed clip at once.
# GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
# GEMINI_AUDIO_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_EMBED_DIM=768

# Free tier allows 100 embedded texts per minute. Raise on a paid key — this
# only paces an index rebuild so it is not throttled.
# GEMINI_EMBED_RPM=90

# --- retrieval ---------------------------------------------------------------
# The similarity gate is calibrated to the encoder. At 768 dims the on-topic and
# off-topic bands separate cleanly (0.638-0.741 vs 0.499-0.567), so 0.60 keeps
# every real question and rejects every off-topic one on the eval set.
# Changing the embedding model invalidates this number.
# RETRIEVAL_MIN_SIMILARITY=0.60
# RETRIEVAL_TOP_K=8
# RETRIEVAL_PER_DOC=2

# Set to `local` to run retrieval embeddings on the bundled BGE ONNX model
# instead of the API (no key, no network, lower quality). The index must be
# rebuilt after changing this — it records which encoder built it and refuses
# to serve a mismatch.
# EMBED_BACKEND=gemini

# --- speech ------------------------------------------------------------------
# `gemini` transcribes with the college vocabulary biased into the prompt and
# falls back to local faster-whisper automatically when the API is unreachable.
# Set to `whisper` to skip Gemini entirely.
# STT_BACKEND=gemini
# WHISPER_MODEL=base
# WHISPER_COMPUTE=int8

# Keep the local Whisper fallback at all. It costs 111-155 MB resident on top of
# a 323 MB steady state, so on a 512 MB instance set this to 0 — 34 MB of
# headroom is not enough to survive a spike. Audio decoding (PyAV) is unaffected;
# it is on the primary path because Gemini will not accept WebM/Opus.
# STT_FALLBACK=1

# --- retrieval quality --------------------------------------------------------
# Chunks more than this far below the best hit are dropped rather than padding
# the prompt to fill RETRIEVAL_TOP_K. `k` is a ceiling, not a quota.
# RETRIEVAL_DROP_MARGIN=0.07
# Above this cosine two chunks are the same content on two pages (this site
# publishes every programme twice, as Shift I and Shift II).
# RETRIEVAL_NEAR_DUPLICATE=0.98
# Below this, nothing retrieved is even loosely related and the question is
# refused without a generation.
# RETRIEVAL_FLOOR=0.45

# LLM reranking of retrieved chunks. OFF by default: measured on this corpus it
# gave no accuracy gain, tripled answer latency (1.2s -> 3.0s), and dropped the
# one chunk that made an admissions question answerable. See kb/rerank.py.
# RERANK=0

# --- voice (local, no key needed) --------------------------------------------
# TTS_VOICE=hf_alpha
# TTS_LANG=en-us
# TTS_SPEED=0.9
# KOKORO_MODEL=auto

# --- service -----------------------------------------------------------------
# ALLOW_ORIGINS=*
# KB_ENABLED=1
# PREWARM=1
# PREWARM_STT=0
# DEBUG=0
