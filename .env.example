# --- required ----------------------------------------------------------------
# One key covers all three remote paths: answering, embeddings, and speech to
# text. GOOGLE_API_KEY is accepted as the older name.
GEMINI_API_KEY=your_gemini_api_key_here

# --- models (defaults shown; all optional) -----------------------------------
# Chosen by measurement rather than by tier — see the table in kb/gemini.py.
# Text and audio differ because the price lists differ by modality: 3.1-flash-lite
# is cheaper per text token, 3.5-flash-lite is cheaper per audio token.
# Do NOT use a "-latest" alias: answer text is the TTS cache key, so a silent
# model swap invalidates every prewarmed clip at once.
# GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
# GEMINI_AUDIO_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_EMBED_DIM=768

# Free tier allows 100 embedded texts per minute. Raise on a paid key — this
# only paces an index rebuild so it is not throttled.
# GEMINI_EMBED_RPM=90

# --- retrieval ---------------------------------------------------------------
# The similarity gate is calibrated to the encoder. At 768 dims the on-topic and
# off-topic bands separate cleanly (0.638-0.741 vs 0.499-0.567), so 0.60 keeps
# every real question and rejects every off-topic one on the eval set.
# Changing the embedding model invalidates this number.
# RETRIEVAL_MIN_SIMILARITY=0.60
# RETRIEVAL_TOP_K=8
# RETRIEVAL_PER_DOC=2

# Set to `local` to run retrieval embeddings on the bundled BGE ONNX model
# instead of the API (no key, no network, lower quality). The index must be
# rebuilt after changing this — it records which encoder built it and refuses
# to serve a mismatch.
# EMBED_BACKEND=gemini

# --- speech ------------------------------------------------------------------
# `gemini` transcribes with the college vocabulary biased into the prompt and
# falls back to local faster-whisper automatically when the API is unreachable.
# Set to `whisper` to skip Gemini entirely.
# STT_BACKEND=gemini
# WHISPER_MODEL=base
# WHISPER_COMPUTE=int8

# Keep the local Whisper fallback at all. It costs 111-155 MB resident on top of
# a 323 MB steady state, so on a 512 MB instance set this to 0 — 34 MB of
# headroom is not enough to survive a spike. Audio decoding (PyAV) is unaffected;
# it is on the primary path because Gemini will not accept WebM/Opus.
# STT_FALLBACK=1

# --- retrieval quality --------------------------------------------------------
# Chunks more than this far below the best hit are dropped rather than padding
# the prompt to fill RETRIEVAL_TOP_K. `k` is a ceiling, not a quota.
# RETRIEVAL_DROP_MARGIN=0.07
# Above this cosine two chunks are the same content on two pages (this site
# publishes every programme twice, as Shift I and Shift II).
# RETRIEVAL_NEAR_DUPLICATE=0.98
# Below this, nothing retrieved is even loosely related and the question is
# refused without a generation.
# RETRIEVAL_FLOOR=0.45

# LLM reranking of retrieved chunks. OFF by default: measured on this corpus it
# gave no accuracy gain, tripled answer latency (1.2s -> 3.0s), and dropped the
# one chunk that made an admissions question answerable. See kb/rerank.py.
# RERANK=0

# --- languages ---------------------------------------------------------------
# English, Tamil, Hindi, Malay. English is the pivot, not just the default:
# every other language is translated to English on the way in and back out
# again, so retrieval, the scope triage, the answer guards and the semantic
# answer cache all keep operating on the English they were calibrated against.
# See services/translate.py for why answering natively in Tamil breaks them.
#
# Trim this to run English-only; it also shrinks the boot prewarm.
# SUPPORTED_LANGS=en,ta,hi,ms

# Which languages to pre-synthesize at boot, in order. English is always warmed
# first regardless of order here, because it is what the first visitor lands on.
# The rest fill in over the following minute while the service already answers;
# a visitor who picks Tamil during that window is slower, not broken.
# Set to `en` on a host where boot CPU matters more than a first Tamil visitor.
# PREWARM_LANGS=en,ta,hi,ms

# Where translated fixed strings are cached, keyed by content hash. Same
# reasoning as TTS_CACHE_DIR: a cold translation cache also means a cold TTS
# cache, because the clips are keyed on the *translated* text.
# TRANSLATION_CACHE_DIR=./translation-cache

# --- phonetic typing ----------------------------------------------------------
# /translit proxies Google Input Tools so a QWERTY keyboard can type Tamil and
# Hindi ("vanakkam" -> வணக்கம்). It is on the keystroke path, so the timeout is
# deliberately shorter than a person's tolerance for a laggy keyboard, and every
# failure returns empty candidates rather than an error.
# TRANSLIT_TIMEOUT_S=1.5
# Its own rate limit, far above /ask: this is called per word while typing, so
# the 20/minute budget that suits a metered model call would cut off a visitor
# mid-sentence.
# TRANSLIT_RATE_LIMIT=600
# TRANSLIT_CACHE=4096

# --- voice --------------------------------------------------------------------
# hf_alpha is a *Hindi* female speaker. That makes Kokoro genuinely native for
# Hindi and an approximation everywhere else — it carries the other languages
# phonetically (every espeak phoneme lands inside its IPA vocabulary) but was
# never trained on their prosody. It remains the fallback for every language.
# TTS_VOICE=hf_alpha

# English and Tamil are delegated to native neural voices. Measured by
# round-tripping each clip back through speech-to-text:
#
#   TAMIL    Kokoro hf_alpha        73.8%   mangles compounds, invents words
#            edge ta-IN-Pallavi     93.7%   <- default
#            gemini-3.1-flash-tts   98.6%   but 3 req/min on the free tier
#
#   ENGLISH  Kokoro hf_alpha        97.0%   RTF 0.48
#            edge en-IN-Neerja      98.9%   RTF 0.23   <- default
#
# English looks like a tie in aggregate, because Kokoro's English pronunciation
# is not wrong. One word decides it: asked to say "Hi, I'm Sia", Kokoro produces
# something that transcribes back as "Hi, I'm J"; Neerja produces "Siya". That
# is the assistant's own name, in the greeting and every introduction.
#
# THE TRADE: English is the default and busiest path, so this makes the primary
# path depend on an endpoint we do not control. The disk cache, the boot prewarm
# and the automatic Kokoro fallback are what make that survivable.
#
# Hindi is deliberately absent — hf_alpha is already native there. Malay is the
# remaining approximation; add `ms=edge:ms-MY-YasminNeural` to fix it too.
# Set to "" to force Kokoro everywhere (no network, no unofficial endpoint).
# TTS_VOICE_OVERRIDES=en=edge:en-IN-NeerjaNeural,ta=edge:ta-IN-PallaviNeural
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# The phonemizer language for ENGLISH only. Every other language takes its
# espeak code from the registry in languages.py.
# TTS_LANG=en-us
# TTS_SPEED=0.9
# KOKORO_MODEL=auto

# Sentences synthesized at once, each on its own Kokoro session. This is what
# keeps streamed speech continuous: one session runs at RTF 0.95 on int8, which
# is slower than the listener consumes it, so gaps open at every sentence.
# Measured: 1 worker RTF 0.95 (2 gaps), 2 workers RTF 0.62 (no gaps).
# Each worker costs another copy of the weights (~92 MB int8).
# TTS_WORKERS=2

# Concurrency for the REMOTE voices, which get their own pool. TTS_WORKERS is a
# memory budget (each Kokoro worker holds the weights); a network worker sits on
# a socket and costs nothing, so the two cannot share a width. Measured with the
# pools shared, a five-sentence English answer serialized through two workers and
# reached first audio in 3.85s; on its own pool it is 2.06s.
# TTS_NET_WORKERS=6

# ONNX threads PER SESSION. Leave unset: it defaults to the 4-thread budget
# divided by TTS_WORKERS, because 2 sessions x 2 threads measured faster than
# 2 x 4 (eight busy threads contend more than they compute).
# ONNX_THREADS=

# Trim the vocoder's leading/trailing silence and replace it with one uniform
# pause, so butt-joined sentences do not inherit ~135 ms of dead air per seam.
# TTS_TRIM_SILENCE=1

# Max characters in the opening clip — the only one the listener waits on.
# Was 110 when synthesis was serial and clip 1 had to fund clip 2's synthesis;
# with TTS_WORKERS>1 that constraint is gone, so a shorter opener starts sooner.
# TTS_FIRST_SENTENCE_CHARS=60

# --- service -----------------------------------------------------------------
# ALLOW_ORIGINS=*
# KB_ENABLED=1
# PREWARM=1
# PREWARM_STT=0
# DEBUG=0
